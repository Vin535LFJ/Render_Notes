{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Render_Notes Document Registry",
  "description": "Generated by tools/build_document_registry.py from per-document frontmatter. Do not hand-edit (AGENT_RULES rule 4).",
  "type": "object",
  "required": ["meta", "documents"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["generated_at", "generator", "total"],
      "properties": {
        "generated_at": {"type": "string"},
        "generator": {"type": "string"},
        "total": {"type": "integer"},
        "counts_by_status": {"type": "object", "additionalProperties": {"type": "integer"}},
        "counts_by_level": {"type": "object", "additionalProperties": {"type": "integer"}},
        "counts_by_type": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["path", "type", "status"],
      "properties": {
        "path": {"type": "string", "description": "repo-relative POSIX path"},
        "id": {"type": "string", "description": "doc_id from frontmatter, else derived from path"},
        "type": {"type": "string", "enum": ["knowledge", "research-report", "change-proposal", "adr", "kcr", "agent-plan", "run-log", "skill", "project-state", "standard", "template", "adapter", "review-material", "data-config"]},
        "type_source": {"type": "string", "enum": ["frontmatter", "heuristic"]},
        "status": {"type": "string", "enum": ["draft", "proposed", "under_review", "approved", "active", "superseded", "archived", "unregistered"]},
        "level": {"type": "string", "enum": ["L1", "L2", "L3", "unclassified"]},
        "owner": {"type": "string"},
        "created": {"type": "string"},
        "updated": {"type": "string"},
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "related_adr": {"type": "array", "items": {"type": "string"}},
        "related_task": {"type": "string"},
        "generated": {"type": "boolean"},
        "frontmatter_present": {"type": "boolean"}
      }
    }
  }
}
